# ==================================================
# VeriFlow Backend Configuration
# ==================================================

# Server & Project
PROJECT_NAME="VeriFlow Invoice Exception Detection Engine"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration
# Local SQLite:
DATABASE_URL="sqlite:///./veriflow.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/veriflow"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_ALL=true

# Policy Rules & Thresholds
MAX_AUTO_APPROVAL_AMOUNT=300000.0
DUPLICATE_WINDOW_DAYS=30
TAX_TOLERANCE_PERCENTAGE=1.0
AUTO_APPROVE_CONFIDENCE=95.0

# Upload directory
UPLOAD_DIR="./uploads"

# AI Service Configuration
# Choices: "mock" (built-in intelligent demo without API keys), "openai", "gemini", "anthropic"
AI_PROVIDER="mock"
AI_MODEL_NAME="gpt-4o-mini"
# OPENAI_API_KEY="your-openai-key-here"
# GEMINI_API_KEY="your-gemini-key-here"
# ANTHROPIC_API_KEY="your-anthropic-key-here"
